#!/usr/bin/env node
/**
 * harness-link-skills.js — Enlaza .harness/skills/ con la carpeta de skills de cada agente IA
 * Generado por harness-kit · Proyecto: {{PROJECT_NAME}}
 *
 * USO:
 *   node scripts/harness-link-skills.js                    # agentes detectados en el proyecto
 *   node scripts/harness-link-skills.js --list             # muestra la matriz y que se detecta
 *   node scripts/harness-link-skills.js --agents=cursor,qwen-code   # fuerza estos agentes
 *   node scripts/harness-link-skills.js --all              # todos los agentes de la matriz
 *   node scripts/harness-link-skills.js --dry-run          # no escribe nada
 *   node scripts/harness-link-skills.js --copy             # copia en vez de symlink/junction
 *   node scripts/harness-link-skills.js --source DIR --root DIR
 *
 * Que agentes existen, que carpeta usa cada uno y como se detectan esta en
 * harness-agents.json (junto a este script). Para soportar un agente nuevo basta
 * con anadir una entrada alli; este script no cambia.
 *
 * Por cada agente: symlink (junction en Windows) hacia la fuente; si falla, copia.
 * Nunca sobrescribe: si el destino ya es una carpeta real solo anade los skills que
 * faltan.
 */

const fs = require('fs');
const path = require('path');

// ─────────────────────────────────────────────────────────────
// Argumentos
// ─────────────────────────────────────────────────────────────

const argv = process.argv.slice(2);
function flag(name) { return argv.includes(`--${name}`); }
function option(name) {
  const eq = argv.find(a => a.startsWith(`--${name}=`));
  if (eq) return eq.slice(name.length + 3);
  const i = argv.indexOf(`--${name}`);
  return i !== -1 && argv[i + 1] && !argv[i + 1].startsWith('--') ? argv[i + 1] : null;
}

const SCRIPT_DIR = __dirname;
const ROOT = path.resolve(
  option('root') || (path.basename(SCRIPT_DIR) === 'scripts' ? path.dirname(SCRIPT_DIR) : process.cwd())
);
const SOURCE = path.resolve(option('source') || path.join(ROOT, '.harness', 'skills'));
const DRY = flag('dry-run');
const FORCE_COPY = flag('copy');
const PROJECT = '{{PROJECT_NAME}}'.startsWith('{{') ? path.basename(ROOT) : '{{PROJECT_NAME}}';

// ─────────────────────────────────────────────────────────────
// Matriz de agentes
// ─────────────────────────────────────────────────────────────

const MATRIX_PATH = path.join(SCRIPT_DIR, 'harness-agents.json');
if (!fs.existsSync(MATRIX_PATH)) {
  console.error(`  ❌  Falta ${MATRIX_PATH} (matriz de agentes). Copialo desde harness-kit-install/templates/.`);
  process.exit(1);
}
const MATRIX = JSON.parse(fs.readFileSync(MATRIX_PATH, 'utf8'));
const AGENTS = MATRIX.agents;

function isDetected(agent) {
  return (agent.detect || []).some(p => fs.existsSync(path.join(ROOT, p)));
}

// ─────────────────────────────────────────────────────────────
// Seleccion de agentes
// ─────────────────────────────────────────────────────────────

if (flag('list')) {
  console.log(`\n  Matriz de agentes (${MATRIX_PATH})\n`);
  for (const a of AGENTS) {
    const det = isDetected(a) ? 'detectado' : (a.always ? 'siempre   ' : 'no        ');
    console.log(`  ${det}  ${a.id.padEnd(16)} skills: ${String(a.skills || '(usa .agents/skills)').padEnd(24)} instrucciones: ${a.instructions || '(lee AGENTS.md)'}`);
  }
  console.log('');
  process.exit(0);
}

const requested = (option('agents') || '').split(',').map(s => s.trim()).filter(Boolean);
const unknown = requested.filter(id => !AGENTS.some(a => a.id === id));
if (unknown.length) {
  console.error(`  ❌  Agentes desconocidos: ${unknown.join(', ')}. Usa --list para ver los validos.`);
  process.exit(1);
}

const selected = AGENTS.filter(a =>
  flag('all') || a.always || requested.includes(a.id) || isDetected(a)
);

// ─────────────────────────────────────────────────────────────
// Helpers
// ─────────────────────────────────────────────────────────────

function samePath(a, b) {
  return path.resolve(a) === path.resolve(b);
}

function linkPointsToSource(target) {
  try {
    if (!fs.lstatSync(target).isSymbolicLink()) return false;
    const dest = fs.readlinkSync(target);
    return samePath(path.resolve(path.dirname(target), dest), SOURCE);
  } catch {
    return false;
  }
}

function isRealDir(target) {
  try {
    const st = fs.lstatSync(target);
    return st.isDirectory() && !st.isSymbolicLink();
  } catch {
    return false;
  }
}

function trySymlink(target) {
  try {
    fs.mkdirSync(path.dirname(target), { recursive: true });
    // En Windows 'junction' no requiere permisos de administrador
    const type = process.platform === 'win32' ? 'junction' : 'dir';
    fs.symlinkSync(SOURCE, target, type);
    return { ok: true };
  } catch (err) {
    return { ok: false, error: err.message };
  }
}

function copyDir(src, dest, onlyMissing) {
  fs.mkdirSync(dest, { recursive: true });
  let added = 0;
  for (const entry of fs.readdirSync(src, { withFileTypes: true })) {
    const s = path.join(src, entry.name);
    const d = path.join(dest, entry.name);
    if (onlyMissing && fs.existsSync(d)) continue;
    if (entry.isDirectory()) added += copyDir(s, d, false) || 1;
    else { fs.copyFileSync(s, d); added++; }
  }
  return added;
}

const rel = p => path.relative(ROOT, p).split(path.sep).join('/');

// ─────────────────────────────────────────────────────────────
// Main
// ─────────────────────────────────────────────────────────────

console.log('\n══════════════════════════════════════════════════');
console.log(`  HARNESS LINK SKILLS — ${PROJECT}${DRY ? '  (dry-run)' : ''}`);
console.log('══════════════════════════════════════════════════\n');

if (!fs.existsSync(SOURCE)) {
  console.log(`  ⚠️  No existe ${rel(SOURCE) || SOURCE} — nada que enlazar.`);
  console.log('     Crea al menos un skill en esa carpeta y vuelve a ejecutar.\n');
  console.log('══════════════════════════════════════════════════\n');
  process.exit(0);
}

console.log(`  Fuente : ${rel(SOURCE) || '.'}`);
console.log(`  Agentes: ${selected.map(a => a.id).join(', ')}\n`);

// Varios agentes pueden compartir carpeta destino: se procesa una sola vez.
const done = new Map();
let ok = 0, failed = 0;

for (const agent of selected) {
  if (!agent.skills) {
    console.log(`  ℹ️  ${agent.name}: sin carpeta propia — usa .agents/skills`);
    continue;
  }
  const target = path.join(ROOT, agent.skills);

  if (done.has(target)) {
    console.log(`  ✅  ${agent.name}: comparte ${agent.skills}/`);
    continue;
  }

  let status;
  if (linkPointsToSource(target)) {
    status = { ok: true, msg: `ya enlazado → ${agent.skills}/` };
  } else if (isRealDir(target)) {
    if (DRY) {
      status = { ok: true, msg: `carpeta existente, se anadirian los skills que falten → ${agent.skills}/` };
    } else {
      const n = copyDir(SOURCE, target, true);
      status = { ok: true, msg: `carpeta existente conservada${n ? `, ${n} elemento(s) nuevo(s)` : ''} → ${agent.skills}/` };
    }
  } else if (fs.existsSync(target)) {
    status = { ok: false, msg: `${agent.skills} existe y no es una carpeta — revisalo a mano` };
  } else if (DRY) {
    status = { ok: true, msg: `se crearia ${FORCE_COPY ? 'copia' : 'symlink'} → ${agent.skills}/` };
  } else {
    let r = FORCE_COPY ? { ok: false, error: '--copy' } : trySymlink(target);
    if (r.ok) {
      status = { ok: true, msg: `symlink creado → ${agent.skills}/` };
    } else {
      try {
        copyDir(SOURCE, target, false);
        status = { ok: true, msg: `copiado → ${agent.skills}/  (la copia NO se sincroniza sola: vuelve a ejecutar este script al anadir skills)` };
      } catch (err) {
        status = { ok: false, msg: `fallo symlink (${r.error}) y copia (${err.message})` };
      }
    }
  }

  done.set(target, true);
  console.log(`  ${status.ok ? '✅' : '❌'}  ${agent.name}: ${status.msg}`);
  status.ok ? ok++ : failed++;
}

console.log('\n══════════════════════════════════════════════════');
if (failed === 0) {
  console.log(`  ✅  [SKILLS OK] — ${ok} destino(s) con skills disponibles`);
} else {
  console.log(`  ❌  [SKILLS PARCIAL] — ${ok} OK · ${failed} fallido(s)`);
  console.log('      Revisa los errores de arriba y vuelve a ejecutar.');
}
console.log('══════════════════════════════════════════════════\n');

process.exit(failed > 0 ? 1 : 0);
