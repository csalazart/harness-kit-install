#!/usr/bin/env bash
# Realiza consultas semánticas al grafo de conocimiento de Graphify.

set -e

if [ $# -eq 0 ]; then
    echo -e "\e[33m⚠️ Debes proporcionar una pregunta o término de búsqueda entre comillas.\e[0m"
    echo -e "Uso: ./scripts/query-graph.sh \"¿Cómo funciona el módulo de autenticación?\""
    exit 1
fi

QUERY="$*"

ROOT="$(pwd)"
PYTHON_FILE="$ROOT/graphify-out/.graphify_python"

if [ ! -f "$PYTHON_FILE" ]; then
    echo -e "\e[33m⚠️ No se encontró la configuración de Graphify en 'graphify-out/'."
    echo -e "Debes ejecutar Graphify por primera vez desde tu Agente de IA (Claude Code, Gemini, Cursor...)"
    echo -e "para instalar dependencias, inicializar el grafo semántico y configurar el intérprete de Python de forma segura.\e[0m"
    exit 1
fi

GRAPH_JSON="$ROOT/graphify-out/graph.json"
if [ -f "$GRAPH_JSON" ] && command -v git >/dev/null 2>&1 && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    GRAPH_MTIME=$(date -r "$GRAPH_JSON" +%s 2>/dev/null || echo 0)
    LAST_COMMIT=$(git log -1 --format=%ct 2>/dev/null || echo 0)
    if [ "$LAST_COMMIT" -gt "$GRAPH_MTIME" ]; then
        echo -e "\e[33m⚠️ El grafo podría estar desactualizado (hay commits posteriores a la última actualización). Considera ejecutar ./scripts/update-graph.sh\e[0m"
    fi
fi

PYTHON_BIN=$(cat "$PYTHON_FILE" | tr -d '\r')
echo -e "\e[36m🔍 Interrogando al grafo de conocimiento de forma semántica...\e[0m"
"$PYTHON_BIN" -m graphify query "$QUERY"
